# ── FalkorDB ──────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_GRAPH=ripple

# ── GitHub ────────────────────────────────────────────────
# repo-scoped token; only needed for GitHub issues enrichment
GITHUB_TOKEN=

# ── LLM (OpenRouter default) ──────────────────────────────
# openrouter | ollama
LLM_PROVIDER=openrouter
# any OpenRouter model id, e.g. anthropic/claude-sonnet-4.5, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
# optional attribution headers sent with OpenRouter requests
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# ── Ollama (only for LLM_PROVIDER=ollama) ─────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Phase 5: CI feedback webhook ─────────────────────────
# optional HMAC secret for /api/ci-webhook; set to verify GitHub signatures
WEBHOOK_SECRET=
