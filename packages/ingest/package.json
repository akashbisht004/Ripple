  },
  "dependencies": {
    "@ripple/core": "*",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
