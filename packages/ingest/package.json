{
  "name": "@ripple/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "ingest": "tsx --env-file=../../.env src/cli.ts",
